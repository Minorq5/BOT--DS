# Токен бота: Developer Portal → Bot → Reset Token. Никому не показывай.
DISCORD_TOKEN=
# ID сервера: режим разработчика → ПКМ по серверу → Копировать ID.
GUILD_ID=

# Фаза 7 — мост с сайтом. Длинная случайная строка (python -c "import secrets;print(secrets.token_urlsafe(32))").
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8080
# Через запятую, например veritas.example.com
ALLOWED_SITE_DOMAINS=
# Ссылка на сайт для текста правил (необязательно)
SITE_URL=

# manual — решают Доверенные; auto — авто-принятие, если все проверки пройдены
VERIFY_MODE=manual
# Вернуть Последователя принятому ранее человеку при перезаходе
RESTORE_ON_REJOIN=false
# Может ли Глава Совета назначать Членов Совета
HEAD_CAN_APPOINT_COUNCIL=false

LOG_LEVEL=INFO
DB_PATH=data/veritas.db

# ── Хостинг без постоянного диска (Render Free) ──
# Хранить копию базы в скрытом канале Discord и восстанавливать её при старте
DB_BACKUP_TO_DISCORD=false
DB_BACKUP_MINUTES=10
# Публичный адрес для само-пинга (на Render берётся из RENDER_EXTERNAL_URL автоматически)
PUBLIC_URL=
KEEPALIVE_MINUTES=
